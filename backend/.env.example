# ========================================================
# CHORANTA — INTERNAL AGENT STUDIO CONFIGURATION
# ========================================================

# Deployment Environment: development | test | production
ENVIRONMENT=development

PROJECT_NAME="Choranta Internal Agent Studio"
VERSION="0.1.0"
API_V1_PREFIX="/api"

# --------------------------------------------------------
# DATABASE (PostgreSQL / Supabase PostgreSQL required in production)
# --------------------------------------------------------
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Local development only:
DATABASE_URL=sqlite:///./choranta_dev.db

# --------------------------------------------------------
# SUPABASE AUTHENTICATION
# --------------------------------------------------------
# Supabase project URL (e.g., https://[YOUR-PROJECT-REF].supabase.co)
SUPABASE_URL=

# Supabase JWT Secret (found in Project Settings -> API -> JWT Settings)
# Used to verify incoming Supabase Auth JWT access tokens:
SUPABASE_JWT_SECRET=

# Supabase Service Role Key (Backend privileged operations only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Anon Key (Public key for Supabase Auth API)
SUPABASE_ANON_KEY=

# --------------------------------------------------------
# INTERNAL JWT KEY (Used if verifying internal tokens directly)
# --------------------------------------------------------
# Must be at least 32 characters in production:
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------
# INITIAL PLATFORM ADMINISTRATOR (Configured on initial deployment)
# --------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Choranta Platform Admin"

# --------------------------------------------------------
# CORS (Comma-separated origins, no wildcards in production)
# --------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --------------------------------------------------------
# VOICE RUNTIME & PROVIDERS (Phase 3B)
# --------------------------------------------------------
# Runtime provider mode: mock | provider
RUNTIME_MODE=mock

# Cartesia Voice Engine (STT & TTS)
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Google Gemini API (LLM)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash




# --------------------------------------------------------
# TELEPHONY — EXOTEL (Phase 3C)
# --------------------------------------------------------
# API credentials: Exotel Dashboard -> Settings -> API Settings
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com
# Shared secret appended as ?token=... to the Voicebot dynamic URL and Passthru URL
# (Exotel does not sign webhooks). Required in production.
EXOTEL_WEBHOOK_SECRET=
# Public HTTPS base URL Exotel can reach (used to build the wss:// media stream URL)
TELEPHONY_BASE_URL=
# Exotel App Bazaar Voicebot Flow ID for Outbound Calls (e.g. 1341429)
EXOTEL_FLOW_ID=

