# ========================================================
# CHORANTA — INTERNAL AGENT STUDIO CONFIGURATION
# ========================================================

# Deployment Environment: development | test | production
ENVIRONMENT=development

PROJECT_NAME="Choranta Internal Agent Studio"
VERSION="0.1.0"
API_V1_PREFIX="/api"

# --------------------------------------------------------
# DATABASE (PostgreSQL / Supabase PostgreSQL required in production)
# --------------------------------------------------------
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Local development only:
DATABASE_URL=sqlite:///./choranta_dev.db

# --------------------------------------------------------
# SUPABASE AUTHENTICATION
# --------------------------------------------------------
# Supabase project URL (e.g., https://[YOUR-PROJECT-REF].supabase.co)
SUPABASE_URL=

# Supabase JWT Secret (found in Project Settings -> API -> JWT Settings)
# Used to verify incoming Supabase Auth JWT access tokens:
SUPABASE_JWT_SECRET=

# Supabase Service Role Key (Backend privileged operations only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Anon Key (Public key for Supabase Auth API)
SUPABASE_ANON_KEY=

# --------------------------------------------------------
# INTERNAL JWT KEY (Used if verifying internal tokens directly)
# --------------------------------------------------------
# Must be at least 32 characters in production:
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --------------------------------------------------------
# INITIAL PLATFORM ADMINISTRATOR (Configured on initial deployment)
# --------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Choranta Platform Admin"

# --------------------------------------------------------
# CORS (Comma-separated origins, no wildcards in production)
# --------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --------------------------------------------------------
# VOICE RUNTIME & PROVIDERS (Phase 3B)
# --------------------------------------------------------
# Runtime provider mode: mock | provider
RUNTIME_MODE=mock

# Cartesia Voice Engine (STT & TTS)
# https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Google Gemini API (LLM)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Sarvam LLM (select "Sarvam" as the agent's LLM provider)
# https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_REASONING_EFFORT=none
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_STREAMING=true

# Force one provider for every agent (e.g. sarvam); empty = each agent's own settings
STT_PROVIDER_OVERRIDE=
TTS_PROVIDER_OVERRIDE=
LLM_PROVIDER_OVERRIDE=




# --------------------------------------------------------
# TELEPHONY — CARRIER
# --------------------------------------------------------
# Carrier for calls placed without one of the client's own numbers: vobiz (default) or exotel.
# Calls from a phone number always use that number's own carrier.
TELEPHONY_PROVIDER=vobiz

# --------------------------------------------------------
# TELEPHONY — VOBIZ
# --------------------------------------------------------
# API credentials: console.vobiz.ai -> Auth ID / Auth Token
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Shared secret appended as ?token=... to the Answer, Hangup and media stream URLs. Required in production.
VOBIZ_WEBHOOK_SECRET=
# Your Vobiz number (E.164, e.g. +9180XXXXXXXX), shown as caller ID on Test Lab calls
VOBIZ_CALLER_ID=
# For inbound calls, set your Vobiz number's Answer URL to
#   {TELEPHONY_BASE_URL}/api/telephony/vobiz/answer?token={VOBIZ_WEBHOOK_SECRET}   (method POST)
# and its Hangup URL to {TELEPHONY_BASE_URL}/api/telephony/vobiz/hangup?token={VOBIZ_WEBHOOK_SECRET}

# --------------------------------------------------------
# TELEPHONY — EXOTEL (Phase 3C)
# --------------------------------------------------------
# API credentials: Exotel Dashboard -> Settings -> API Settings
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai)
EXOTEL_SUBDOMAIN=api.exotel.com
# Shared secret appended as ?token=... to the Voicebot dynamic URL and Passthru URL
# (Exotel does not sign webhooks). Required in production.
EXOTEL_WEBHOOK_SECRET=
# Public HTTPS base URL Exotel can reach (used to build the wss:// media stream URL)
TELEPHONY_BASE_URL=
# Exotel App Bazaar Voicebot Flow ID for Outbound Calls (e.g. 1341429)
EXOTEL_FLOW_ID=
# Your ExoPhone, shown as caller ID when an agent calls a number from the Test Lab
EXOTEL_CALLER_ID=

# --------------------------------------------------------
# CALL COST ESTIMATES (shown in rupees per call and per minute)
# Set these to your plans' actual rates.
# --------------------------------------------------------
TELEPHONY_RATE_PER_MINUTE_INR=0.80
TELEPHONY_BILLING_PULSE_SECONDS=60
STT_USD_PER_MINUTE=0.00118
TTS_USD_PER_MINUTE=0.0353
LLM_INPUT_USD_PER_MILLION_TOKENS=0.30
LLM_OUTPUT_USD_PER_MILLION_TOKENS=2.50
USD_TO_INR=88.0
SARVAM_INPUT_INR_PER_MILLION_TOKENS=15
SARVAM_OUTPUT_INR_PER_MILLION_TOKENS=60
SARVAM_STT_INR_PER_HOUR=30
SARVAM_TTS_INR_PER_10K_CHARS=30

# --------------------------------------------------------
# PHONE CALL COST CONTROLS
# --------------------------------------------------------
VOICE_MAX_REPLY_CHARS=220
VOICE_PREFETCH_SENTENCES=1
# Repeated sentences (greeting, farewell, common replies) replay from memory instead of being re-synthesized; 0 = off
VOICE_TTS_CACHE_MB=64
CALL_SILENCE_REPROMPT_S=8
CALL_SILENCE_HANGUP_S=8
CALL_MAX_DURATION_S=600

# --------------------------------------------------------
# GOOGLE SIGN-IN (everyone signs in with Google; password login = initial admin only)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173 (+ your production domain)
# --------------------------------------------------------
GOOGLE_CLIENT_ID=
# true = any Google account can sign up as a new client; false = invite-only
CLIENT_SELF_SIGNUP=true

# --------------------------------------------------------
# BILLING (prepaid wallet + GST invoices)
# --------------------------------------------------------
BILLING_ENFORCED=true
COMPANY_LEGAL_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE_CODE=36
INVOICE_PREFIX=CHR
# Confirm the SAC code for your service with your CA
INVOICE_SAC_CODE=998319
GST_RATE_PERCENT=18
# Shown to clients in the portal under "How to recharge"
PAYMENT_UPI_ID=
PAYMENT_BANK_DETAILS=
# Plans: calls keep working this many days after a period ends unpaid
SUBSCRIPTION_GRACE_DAYS=3
MIN_WALLET_TOPUP_INR=500
# Phone number rent comes from the wallet monthly; unpaid numbers are released after this many days
NUMBER_GRACE_DAYS=3
# Campaigns: how often the dialer runs, and the most new calls per minute across all campaigns (Exotel default: 60)
CAMPAIGN_TICK_S=5
CAMPAIGN_MAX_DIALS_PER_MIN=60
# true = fake Exotel number search/purchase for local testing
EXOTEL_NUMBERS_MOCK=false

# --------------------------------------------------------
# RAZORPAY (clients pay for plans and wallet top-ups online)
# Dashboard -> Account & Settings -> API Keys (use Test Mode keys while developing)
# Webhook: Dashboard -> Webhooks -> URL <TELEPHONY_BASE_URL>/api/billing/razorpay/webhook,
#          events payment.captured + order.paid, and the secret below
# --------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Testing only: with no Razorpay keys, "Choose plan" and "Buy credits" succeed instantly (no money moves).
# Never enable in production (the server refuses to start).
SIMULATED_PAYMENTS=false
